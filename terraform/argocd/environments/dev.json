{
  "ssm_path_prefix": "/gitops/dev/clusters",
  "mgmt_cluster_label": "lke-dev-mgmt",
  "worker_cluster_label": "lke-dev-ateam",
  "private_network": {
    "enabled": true,
    "environment": "dev",
    "linode_region": "ap-south",
    "base_domain_parameter_name": "/gitops/platform-access/network/BASE_DOMAIN",
    "vpn_public_egress_ip_parameter_name": "/gitops/platform-access/network/VPN_PUBLIC_EGRESS_IP",
    "endpoint_ip_parameter_name": "/gitops/dev/platform/argocd/ENDPOINT_IP",
    "endpoint_hostname_parameter_name": "/gitops/dev/platform/argocd/ENDPOINT_HOSTNAME",
    "openvpn_server_public_ipv6": null,
    "argocd_https_port": 443,
    "argocd_tls_secret_name": "argocd-server-tls"
  },
  "root_applications": {
    "ateam": {
      "name": "root-application-dev",
      "manifest": "ateam/root-application-dev.yaml"
    }
  }
}
